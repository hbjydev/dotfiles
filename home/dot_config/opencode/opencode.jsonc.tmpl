// vim:ft=jsonc
{
  "$schema": "https://opencode.ai/config.json",

  // Model config
  "model": "opencode-go/qwen3.5-plus",
  "small_model": "opencode-go/qwen3.5-plus",

  "plugin": [
    "@franlol/opencode-md-table-formatter@0.0.3"
  ],

  // MCP Servers
  "mcp": {
    "homelab": {
      "type": "remote",
      "url": "https://mcp.hayden.moe/mcp",
      "enabled": true,
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "sequential_thinking": {
      "type": "local",
      "command": ["bunx", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    }
  },

  // Other
  "share": "disabled",
  "instructions": ["AGENTS.md", "CONTRIBUTING.md", ".github/copilot-instructions.md", "CLAUDE.md"]
}
