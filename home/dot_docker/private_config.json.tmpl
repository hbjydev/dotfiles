{{- $ghcrToken := onepasswordRead "op://dots/gh-cli-token/password" -}}
{{- $ghcrAuth := (printf "%s:%s" "hbjydev" $ghcrToken) | b64enc -}}
{{- $forgejoToken := onepasswordRead "op://dots/fjo-token/password" -}}
{{- $forgejoAuth := (printf "%s:%s" "hayden" $forgejoToken) | b64enc -}}
{
  "cliPluginsExtraDirs": [
    "{{ .chezmoi.homeDir }}/.local/share/mise/installs/docker-compose/latest",
    "{{ .chezmoi.homeDir }}/.local/share/mise/installs/github-docker-buildx/latest"
  ],
  "auths": {
    "git.hayden.moe": {
      "auth": "{{ $forgejoAuth }}"
    },
    "ghcr.io": {
      "auth": "{{ $ghcrAuth }}"
    }
  },
  "currentContext": "colima",
  "credHelpers": {
    "gcr.io": "gcloud",
    "us.gcr.io": "gcloud",
    "eu.gcr.io": "gcloud",
    "asia.gcr.io": "gcloud",
    "staging-k8s.gcr.io": "gcloud",
    "marketplace.gcr.io": "gcloud",
    "europe-west2-docker.pkg.dev": "gcloud"
  }
}
